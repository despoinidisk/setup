#!/usr/bin/env bash
#
# setup - Generic project lifecycle manager.
# v1.0.0 (2026-08-25)
# Konstantinos Despoinidis <despoinidis@lioncode.gr>
#
# Manages project services (start, stop, logs) through a project-specific
# .setup hook file. The setup script itself is identical across all projects;
# only .setup is modified per project.
#
# USAGE
#     setup up [-d|--detach]   Start all services
#     setup down               Stop all services
#     setup logs               Tail service logs (detached mode only)
#
#     -d, --detach             Run services in the background
#
# SETUP FILE
#     Create a .setup file in the project root defining up() and down():
#
#         up() {
#             local detached="${1:-0}"
#             _start_bg api "$detached" make api.start
#             _wait_http "http://localhost:8000/health" "API"
#         }
#
#         down() {
#             _kill_component api
#         }
#
# AVAILABLE UTILITIES (for use in .setup)
#     Logging:
#         INFO "message"        Log to stdout
#         WARN "message"        Log to stderr
#         ERRO "message"        Log to stderr
#
#     Process management:
#         _start_bg NAME DETACHED CMD [ARGS...]
#                             Start a command in the background, track its PID
#         _kill_component NAME Stop a background process by component name
#         _save_pid NAME PID   Save a PID file for a named component
#         _wait_http URL LABEL [ATTEMPTS]
#                             Poll an HTTP endpoint until it responds (default 90s)
#
#     Environment:
#         _load_env            Source .env from the project root
#
#     Paths:
#         ROOT                 Project root ($PWD)
#         PIDS_DIR             PID files directory (.setup-pids/)
#         LOGS_DIR             Log files directory (.setup-logs/)
#
# DIRECTORY STRUCTURE
#     .setup                  Project-specific hooks (up, down)
#     .setup-pids/            PID files for tracked processes
#     .setup-logs/            Stdout/stderr logs from detached processes
#
# NOTE: You should avoid modifying this script to change behaviour.

set -euo pipefail

ROOT="$PWD"
PIDS_DIR="$ROOT/.setup-pids"
LOGS_DIR="$ROOT/.setup-logs"
SETUP_FILE="$ROOT/.setup"
mkdir -p "$PIDS_DIR" "$LOGS_DIR"

LOG() {
    local tag="$1"
    local stream="$2"
    shift 2
    echo "[$tag]" "$@" >&"$stream"
}
INFO() { LOG "INFO" 1 "$@"; }
WARN() { LOG "WARN" 2 "$@"; }
ERRO() { LOG "ERRO" 2 "$@"; }

usage() {
    ERRO "Usage: $(basename "$0") {up [-d|--detach]|down|logs}"
}

_load_env() {
    if [[ -f "$ROOT/.env" ]]; then
        set -a
        # shellcheck disable=SC1091
        source "$ROOT/.env"
        set +a
    fi
}

_wait_http() {
    local url="$1"
    local label="$2"
    local attempts="${3:-90}"
    INFO "Waiting for ${label} (${url})..."
    for _ in $(seq 1 "$attempts"); do
        if curl -sf "$url" >/dev/null 2>&1; then
            INFO "${label} is ready"
            return 0
        fi
        sleep 1
    done
    ERRO "${label} did not become ready in time (${url})"
    return 1
}

_kill_tree() {
    local pid=$1
    local children
    children=$(pgrep -P "$pid" 2>/dev/null) || true
    for child in $children; do
        _kill_tree "$child"
    done
    kill "$pid" 2>/dev/null || true
}

_kill_component() {
    local name="$1"
    local pidfile="$PIDS_DIR/$name.pid"
    [[ -f "$pidfile" ]] || return 0
    local pid
    pid=$(<"$pidfile")
    rm -f "$pidfile"
    if kill -0 "$pid" 2>/dev/null; then
        INFO "$name stopping (pid $pid)"
        _kill_tree "$pid"
        wait "$pid" 2>/dev/null || true
    fi
}

_save_pid() {
    echo "$2" > "$PIDS_DIR/$1.pid"
}

_start_bg() {
    local name="$1"
    local detached="$2"
    shift 2
    if [[ "$detached" -eq 1 ]]; then
        nohup "$@" >"$LOGS_DIR/$name.log" 2>&1 &
        _save_pid "$name" $!
        disown $! 2>/dev/null || true
    else
        "$@" &
        _save_pid "$name" $!
    fi
}

logs() {
    cd "$ROOT"
    local api_log="$LOGS_DIR/api.log"
    local www_log="$LOGS_DIR/www.log"
    if [[ ! -f "$api_log" && ! -f "$www_log" ]]; then
        ERRO "No setup logs yet. Start with: $(basename "$0") up -d"
        exit 1
    fi
    tail -n 80 -f "$api_log" "$www_log"
}

# ── Load project hooks ──────────────────────────────────────────────

if [[ ! -f "$SETUP_FILE" ]]; then
    ERRO "No .setup file found in $ROOT"
    exit 1
fi

# shellcheck disable=SC1091
source "$SETUP_FILE"

# ── Command dispatch ────────────────────────────────────────────────

case "${1:-}" in
    up)
        detach=0
        shift || true
        for arg in "$@"; do
            case "$arg" in
                -d|--detach|--detached) detach=1 ;;
                *) usage; exit 1 ;;
            esac
        done
        up "$detach"
        ;;
    down) down ;;
    logs) logs ;;
    *) usage; exit 1 ;;
esac
